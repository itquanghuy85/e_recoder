    "narrative":  {
                      "northStar":  "The Cue Before the Cut",
                      "overview":  "A broadcast control room borrowed for the screen in your pocket: the signal comes before the thing itself. The world lends palette, one condensed numeric face, calm density and the cue to take sequence; structure stays Material 3.",
                      "keyCharacteristics":  [
                                                 "Tally red means live or the one record action.",
                                                 "Selection, playhead and links are key cyan; paused and lead-in are cue amber.",
                                                 "Tonal layering and hairlines instead of shadows.",
                                                 "Timecodes are tabular and right-aligned.",
                                                 "Markers carry an opposite-luminance halo."
                                             ],
                      "rules":  [
                                    {
                                        "section":  "colors",
                                        "body":  "Tally red appears only while recording or on the record action that starts it.",
                                        "name":  "The Live-Only Red Rule"
                                    },
                                    {
                                        "section":  "colors",
                                        "body":  "Anything drawn over another app carries a halo or border of the opposite luminance.",
                                        "name":  "The Halo Rule"
                                    },
                                    {
                                        "section":  "typography",
                                        "body":  "Every time value uses tabular figures and is right-aligned in lists.",
                                        "name":  "The Tabular Time Rule"
                                    },
                                    {
                                        "section":  "elevation",
                                        "body":  "Surfaces are flat at rest; a new layer is a surface step or a hairline, never a glow.",
                                        "name":  "The Flat-By-Default Rule"
                                    }
                                ],
                      "dos":  [
                                  "Do keep red for live/record only; use key cyan for every selection and amber for lead-in or paused.",
                                  "Do draw anything over another app with an opposite-luminance halo.",
                                  "Do show timecodes with tabular figures, right-aligned.",
                                  "Do give every control a text or icon label and a 48 dp target.",
                                  "Do keep light and dark schemes on the same role names."
                              ],
                      "donts":  [
                                    "Don\u0027t use tally red for selection, links, switches or export.",
                                    "Don\u0027t add drop shadows or glows.",
                                    "Don\u0027t put a coloured side border above 1 px on cards or alerts.",
                                    "Don\u0027t hide the recording state.",
                                    "Don\u0027t invent a second type family."
                                ]
